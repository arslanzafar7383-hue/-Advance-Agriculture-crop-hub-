# GEMINI_API_KEY: Required for Gemini AI API calls.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# WEATHER_API_KEY: Required for real-time agricultural weather API calls (e.g. OpenWeatherMap / WeatherAPI).
# Users configure this via the Secrets panel in AI Studio UI.
WEATHER_API_KEY=PLACEHOLDER_WEATHER_API_KEY
